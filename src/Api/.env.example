# à copier en .env (non versionné)

DATABASE_URL="mysql://user:password@localhost:3306/mvc_template"

# vide = 3000
PORT=3000

# séparées par des virgules, vide = localhost seulement (ex. http://192.168.1.10:5180 pour une autre machine)
CORS_ORIGIN=

# lien "ICI" en pied de page des contrats, vide = pas de lien
CGV_URL=

# PDF générés + documents joints (à sauvegarder avec la base), vide = ./storage
PDF_STORAGE_DIR=

# pour l'OCR (console.mistral.ai)
MISTRAL_API_KEY=

# obligatoire en prod, 32 car. min (openssl rand -base64 48)
JWT_SECRET=

# none si front et API sur des domaines différents (HTTPS obligatoire)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# requêtes par IP et par minute
THROTTLE_LIMIT=300
LOGIN_THROTTLE_LIMIT=5

# en secondes
ACCESS_TOKEN_TTL_SECONDS=900
