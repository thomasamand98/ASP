@inject ThemeService Theme
@inject Browser Browser
@inject UnsavedChangesService Unsaved

<main class="app-shell">
    <AuthGate>
        <CascadingValue Value="Unsaved.Root" IsFixed="true">
            <AppLayout />
        </CascadingValue>
    </AuthGate>
    <UnsavedChangesDialog />
</main>

@code {
    private DotNetObjectReference<UnsavedChangesService>? _unsaved;

    protected override void OnInitialized() => Theme.Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Theme.ApplyAsync();
        // avertit si on ferme/recharge l'onglet avec une saisie en cours
        _unsaved = DotNetObjectReference.Create(Unsaved);
        await Browser.GuardUnloadAsync(_unsaved);
    }
}
