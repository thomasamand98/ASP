@implements IDisposable
@inject AuthSession Session

@* app rendue seulement une fois la session ouverte, aucune requête sans jeton *@
@if (_status == Status.Checking || (_status == Status.Anonymous && !Session.LoginScreenEnabled))
{
    <p style="text-align: center; margin-top: 3rem">Chargement...</p>
}
else if (_status == Status.Error)
{
    <div style="text-align: center; margin-top: 3rem">
        <p>Impossible d’ouvrir la session : @_error</p>
        <button type="button" @onclick="RetryAsync">Réessayer</button>
    </div>
}
else if (_status == Status.Anonymous)
{
    <LoginPage OnLogin="LoginAsync" />
}
else
{
    <CascadingValue Value="_state" IsFixed="true">@ChildContent</CascadingValue>
}

@code {
    private enum Status
    {
        Checking,
        Anonymous,
        Authenticated,
        Error,
    }

    private Status _status = Status.Checking;
    private string _error = "";
    private AuthState? _state;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // renouvellement refusé par l'API en cours de route
        Session.SessionLost += OnSessionLost;
        var login = await Session.RefreshAsync();
        if (login is not null) Authenticate(login);
        else await BecomeAnonymousAsync();
    }

    private void Authenticate(string login)
    {
        _state = new AuthState(login, Session.LoginScreenEnabled, SignOutAsync);
        _status = Status.Authenticated;
    }

    private async Task BecomeAnonymousAsync()
    {
        _status = Status.Anonymous;
        _state = null;
        if (Session.LoginScreenEnabled) return;
        StateHasChanged();
        try
        {
            Authenticate(await Session.LoginAutomaticallyAsync());
        }
        catch (Exception e)
        {
            _error = e is ApiException ? e.Message : "Connexion impossible";
            _status = Status.Error;
        }
    }

    private Task RetryAsync() => BecomeAnonymousAsync();

    private async Task LoginAsync((string Login, string Password) credentials)
    {
        Authenticate(await Session.LoginAsync(credentials.Login, credentials.Password));
        StateHasChanged();
    }

    private async Task SignOutAsync()
    {
        await Session.LogoutAsync();
        await InvokeAsync(BecomeAnonymousAsync);
        StateHasChanged();
    }

    private void OnSessionLost() => _ = InvokeAsync(async () =>
    {
        await BecomeAnonymousAsync();
        StateHasChanged();
    });

    public void Dispose() => Session.SessionLost -= OnSessionLost;
}
