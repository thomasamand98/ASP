@* Modifier seulement pour une ligne, Supprimer affiche le nombre si plusieurs *@
<div class="page-actions">
    <button type="button" class="btn primary" @onclick="OnCreate">
        <Icon Name="pageActions.Plus" />
        Nouveau
    </button>
    <button type="button" class="btn" @onclick="OnEdit" disabled="@(SelectedCount != 1)"
            title="@(SelectedCount > 1 ? "Sélectionnez une seule ligne pour la modifier" : null)">
        <Icon Name="pageActions.Pencil" />
        Modifier
    </button>
    <button type="button" class="btn danger" @onclick="OnDelete" disabled="@(SelectedCount == 0)">
        <Icon Name="pageActions.Trash" />
        Supprimer@(SelectedCount > 1 ? $" ({SelectedCount})" : "")
    </button>
</div>

@code {
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public int SelectedCount { get; set; }
}
