@typeparam T
@typeparam TDto
@typeparam TDetail
@implements IDisposable
@inject Browser Browser
@inject UnsavedChangesService Unsaved

@* Assemble la liste (ApiList), le tableau et la fiche de création /
   modification / suppression d'un écran — gère les 3 états : chargement,
   erreur, données prêtes. Chaque écran ne fournit que ses libellés, ses
   colonnes et son formulaire. *@
@if (!_hasLoaded)
{
    if (Source.Error is not null)
    {
        <p>Erreur : @Source.Error</p>
    }
    else
    {
        <p>@LoadingLabel</p>
    }
}
else
{
    <div>
        <div class="page-header">
            <h2>@(Heading ?? Title) (@TotalCount)</h2>
            <div class="page-header-actions">
                @if (ViewModeRegistry.SelectionEnabled)
                {
                    <ViewModeSelector Value="@_viewModeId" ValueChanged="ChangeViewModeAsync" />
                }
                <PageActions OnCreate="CreateAsync" OnEdit="EditSelectedAsync" OnDelete="DeleteAsync" SelectedCount="Selection.Count" />
                @if (Entity is not null && Projection is not null && Relations.Of[Entity].Count > 0)
                {
                    <ProjectionButton Items="Relations.Of[Entity]" SelectedCount="Selection.Count" OnSelect="OpenProjection" />
                }
            </div>
        </div>
        <ViewModeHost Mode="@_viewModeId" Open="_modalMode is not null" State="@_modalMode" Title="@FormTitle" OnClose="RequestCloseFormAsync"
                      Form="ModeFormSlot" Table="TableArea" />
    </div>
}

@code {
    private HashSet<string> _selectedIds = [];
    // Ligne ouverte en modification (double clic) — distincte de la
    // sélection, qui peut contenir plusieurs lignes.
    private string? _editId;
    private string? _modalMode;
    private TDetail? _editRecord;
    private bool _detailLoading;
    private string _viewModeId = ViewModeRegistry.Default;
    // Passe à true au premier chargement terminé : les rechargements suivants
    // (page, recherche, après enregistrement) gardent la page affichée —
    // sinon le champ Rechercher serait recréé à chaque frappe et perdrait le
    // focus.
    private bool _hasLoaded;
    // Zone de la fiche ouverte (voir Components/UnsavedChanges) : la fermer,
    // ou en ouvrir une autre à sa place, demande d'abord quoi faire d'une
    // saisie modifiée.
    private GuardScope _formScope = default!;

    [CascadingParameter] public GuardScope? Scope { get; set; }
    [CascadingParameter] public TabsContext Tabs { get; set; } = default!;
    [CascadingParameter] public ProjectionContext? Projection { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string LoadingLabel { get; set; } = "";
    [Parameter, EditorRequired] public ApiList<T> Source { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Column<T>> Columns { get; set; } = [];
    [Parameter, EditorRequired] public Func<T, string> GetRowId { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TDto, Task<T>> Create { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, TDto, Task<T>> Update { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, Task> Remove { get; set; } = default!;

    // Récupère la fiche complète d'un enregistrement avant de l'ouvrir, pour
    // les écrans dont le formulaire a besoin de plus de champs que la liste.
    // Absent : la fiche s'ouvre avec la ligne du tableau (TDetail = T).
    [Parameter] public Func<string, Task<TDetail>>? GetDetail { get; set; }

    [Parameter, EditorRequired] public string DeleteConfirmMessage { get; set; } = "";
    [Parameter, EditorRequired] public string CreateModalTitle { get; set; } = "";
    [Parameter, EditorRequired] public string EditModalTitle { get; set; } = "";

    // Rend le formulaire de saisie, avec les données propres à chaque écran.
    [Parameter, EditorRequired] public RenderFragment<FormContext<TDetail, TDto>> RenderForm { get; set; } = default!;

    // Distingue l'onglet de création quand plusieurs tables de la même
    // entité coexistent avec des valeurs par défaut différentes (ex. onglet
    // Contrats de chaque fiche Société) — sinon un seul onglet « Nouveau »
    // par titre.
    [Parameter] public string? NewRecordScope { get; set; }

    // Table affichée (clé de Relations) : active le bouton Projection.
    [Parameter] public string? Entity { get; set; }

    // En-tête affiché à la place de Title (ex. « Contrats de 3 sociétés »
    // pour un résultat de projection) — Title reste utilisé pour les
    // identifiants d'onglet des fiches.
    [Parameter] public string? Heading { get; set; }

    // Filtres affichés à droite du champ Rechercher (ex. ArchiveFilter).
    [Parameter] public RenderFragment? ToolbarExtra { get; set; }

    // Champ Rechercher (recherche serveur sur toutes les colonnes texte).
    [Parameter] public bool Searchable { get; set; }

    private bool IsTabMode => _viewModeId == ViewModeRegistry.Tab;

    private bool IsRowExpandMode => _viewModeId == ViewModeRegistry.RowExpand;

    // Ne garde que les ids encore présents dans les données — une ligne
    // sélectionnée peut disparaître (changement de page, rechargement
    // serveur) sans que la sélection ne soit remise à zéro explicitement.
    private HashSet<string> Selection
    {
        get
        {
            var loaded = Source.Data.Select(GetRowId).ToHashSet();
            return [.. _selectedIds.Where(loaded.Contains)];
        }
    }

    private int TotalCount => Source.Paginated ? Source.Total : Source.Data.Count;

    private string FormTitle => _modalMode == "edit" ? EditModalTitle : CreateModalTitle;

    protected override void OnInitialized()
    {
        _formScope = GuardScopes.CreateChild(Scope, Unsaved);
        _viewModeId = InitialViewMode();
        Source.Changed += OnSourceChanged;
        _hasLoaded = !Source.Loading;
    }

    // Choix du mode désactivé : on ignore un ancien choix enregistré, sinon
    // l'utilisateur resterait bloqué sur un mode qu'il ne peut plus changer.
    private string InitialViewMode()
    {
        if (!ViewModeRegistry.SelectionEnabled) return ViewModeRegistry.Default;
        return Browser.GetItem(ViewModeRegistry.StorageKey) ?? ViewModeRegistry.Default;
    }

    private async Task ChangeViewModeAsync(string id)
    {
        // Changer de mode remonte la fiche ouverte ailleurs : sa saisie serait perdue.
        if (_modalMode is not null && !await Unsaved.ConfirmLeaveAsync(_formScope)) return;
        _modalMode = null;
        _viewModeId = id;
        await Browser.SetItemAsync(ViewModeRegistry.StorageKey, id);
    }

    private void OnSourceChanged()
    {
        if (!Source.Loading) _hasLoaded = true;
        StateHasChanged();
    }

    // Quitte la fiche ouverte (croix, fond, Annuler...) après confirmation si
    // elle a été modifiée.
    private async Task RequestCloseFormAsync()
    {
        if (await Unsaved.ConfirmLeaveAsync(_formScope)) _modalMode = null;
    }

    // Mode « Onglet » : un id stable par enregistrement, pour réactiver son
    // onglet plutôt que d'en rouvrir un second au redouble-clic.
    private string RecordTabId(string? recordId)
    {
        if (recordId is not null) return $"record:{Title}:{recordId}";
        return NewRecordScope is not null ? $"record:{Title}:new:{NewRecordScope}" : $"record:{Title}:new";
    }

    // Libellé de l'onglet d'une ligne : valeur de la première colonne si
    // c'est un champ simple (ex. « Sociétés: YARA TERTRE »), sinon l'id.
    private string RowLabel(T row)
    {
        var first = Columns.Count > 0 ? Columns[0] : null;
        var value = first is { IsKey: true } ? first.Value(row) : null;
        return value is not null && !(value is string { Length: 0 }) ? JsValue.ToJsString(value) : GetRowId(row);
    }

    private async Task ApplySavedAsync(string? recordId, T saved)
    {
        if (Source.Paginated)
        {
            await Source.RefetchAsync();
            return;
        }
        if (recordId is null) Source.Data.Add(saved);
        else Source.Data = [.. Source.Data.Select(row => GetRowId(row) == recordId ? saved : row)];
        Source.NotifyChanged();
    }

    private async Task SubmitTabAsync(string mode, string? recordId, TDto dto)
    {
        var tabId = RecordTabId(recordId);
        try
        {
            var saved = mode == "edit" && recordId is not null ? await Update(recordId, dto) : await Create(dto);
            await ApplySavedAsync(mode == "edit" ? recordId : null, saved);
            // Juste enregistré : rien à confirmer.
            await Tabs.CloseTabAsync(tabId, force: true);
        }
        catch (Exception e)
        {
            await Browser.AlertAsync($"Échec de l'enregistrement : {ErrorMessage(e)}");
        }
    }

    private static string ErrorMessage(Exception e) => e is ApiException ? e.Message : e.Message;

    // Ouvre la fiche de `recordId` (ou une fiche de création si null) dans son
    // propre onglet de l'application.
    private void OpenRecordTab(string mode, string? recordId, TDetail? initial, string label)
    {
        var tabId = RecordTabId(recordId);
        var content = RenderForm(new FormContext<TDetail, TDto>(initial, dto => SubmitTabAsync(mode, recordId, dto), () => Tabs.CloseTabAsync(tabId)));
        Tabs.OpenOrActivateTab(tabId, label, content);
    }

    private async Task RowDoubleClickTabAsync(T row)
    {
        var id = GetRowId(row);
        var label = $"{Title}: {RowLabel(row)}";
        if (GetDetail is null)
        {
            OpenRecordTab("edit", id, (TDetail)(object)row!, label);
            return;
        }
        try
        {
            OpenRecordTab("edit", id, await GetDetail(id), label);
        }
        catch (Exception e)
        {
            await Browser.AlertAsync($"Échec du chargement : {ErrorMessage(e)}");
        }
    }

    private async Task RowDoubleClickAsync(T row)
    {
        if (IsTabMode)
        {
            await RowDoubleClickTabAsync(row);
            return;
        }
        if (_detailLoading) return;
        var id = GetRowId(row);
        // Déjà ouverte : on garde la saisie en cours.
        if (_modalMode == "edit" && _editId == id) return;
        if (_modalMode is not null && !await Unsaved.ConfirmLeaveAsync(_formScope)) return;
        _selectedIds = [id];
        _editId = id;
        if (GetDetail is null)
        {
            // Pas de fiche détaillée à charger : la ligne du tableau sert
            // directement de valeurs initiales (TDetail = T).
            _editRecord = (TDetail)(object)row!;
            _modalMode = "edit";
            return;
        }
        _detailLoading = true;
        try
        {
            _editRecord = await GetDetail(id);
            _modalMode = "edit";
        }
        catch (Exception e)
        {
            await Browser.AlertAsync($"Échec du chargement : {ErrorMessage(e)}");
        }
        finally
        {
            _detailLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (IsTabMode)
        {
            OpenRecordTab("create", null, default, CreateModalTitle);
            return;
        }
        if (_modalMode == "create") return;
        if (_modalMode is not null && !await Unsaved.ConfirmLeaveAsync(_formScope)) return;
        _selectedIds = [];
        _editId = null;
        _modalMode = "create";
    }

    private Task EditSelectedAsync()
    {
        var id = Selection.FirstOrDefault();
        var row = Source.Data.FirstOrDefault(r => GetRowId(r) == id);
        return row is null ? Task.CompletedTask : RowDoubleClickAsync(row);
    }

    // Supprime toutes les lignes sélectionnées, une requête par ligne. Les
    // échecs (ex. ligne encore référencée ailleurs) n'empêchent pas les
    // autres suppressions : les lignes en échec restent sélectionnées.
    private async Task DeleteAsync()
    {
        var ids = Selection.ToList();
        if (ids.Count == 0) return;
        var message = ids.Count == 1 ? DeleteConfirmMessage : $"Supprimer les {ids.Count} éléments sélectionnés ?";
        if (!await Browser.ConfirmAsync(message)) return;
        var results = await Task.WhenAll(ids.Select(async id =>
        {
            try
            {
                await Remove(id);
                return (Id: id, Error: (Exception?)null);
            }
            catch (Exception e)
            {
                return (Id: id, Error: e);
            }
        }));
        var deleted = results.Where(r => r.Error is null).Select(r => r.Id).ToHashSet();
        var failures = results.Where(r => r.Error is not null).ToList();
        if (deleted.Count > 0)
        {
            if (Source.Paginated) await Source.RefetchAsync();
            else
            {
                Source.Data = [.. Source.Data.Where(row => !deleted.Contains(GetRowId(row)))];
                Source.NotifyChanged();
            }
        }
        _selectedIds = [.. ids.Where(id => !deleted.Contains(id))];
        if (failures.Count > 0)
        {
            var detail = ErrorMessage(failures[0].Error!);
            await Browser.AlertAsync(ids.Count == 1
                ? $"Échec de la suppression : {detail}"
                : $"{failures.Count} suppression(s) sur {ids.Count} ont échoué : {detail}");
        }
    }

    private async Task SubmitAsync(TDto dto)
    {
        try
        {
            if (_modalMode == "edit" && _editId is not null) await ApplySavedAsync(_editId, await Update(_editId, dto));
            else await ApplySavedAsync(null, await Create(dto));
            _modalMode = null;
            StateHasChanged();
        }
        catch (Exception e)
        {
            await Browser.AlertAsync($"Échec de l'enregistrement : {ErrorMessage(e)}");
        }
    }

    private void OpenProjection(string target)
    {
        var ids = Selection.ToList();
        var single = ids.Count == 1 ? Source.Data.FirstOrDefault(row => GetRowId(row) == ids[0]) : default;
        Projection!.Open(Entity!, target, ids, single is null ? null : RowLabel(single));
    }

    // Formulaire de la fiche ouverte. @key : une autre fiche ouverte à la
    // place repart de ses propres valeurs.
    private RenderFragment? FormContent => _modalMode is null ? null : @<GuardBoundary @key="@($"{_modalMode}:{_editId ?? "new"}")" Scope="_formScope">
        @RenderForm(new FormContext<TDetail, TDto>(_modalMode == "edit" ? _editRecord : default, SubmitAsync, RequestCloseFormAsync))
    </GuardBoundary>;

    // Mode « Ligne + bloc » : la modification déplie la ligne directement
    // dans le tableau au lieu d'utiliser le bloc du haut — le formulaire ne
    // va donc que dans un seul des deux emplacements à la fois.
    private RenderFragment? ModeFormSlot => IsRowExpandMode ? (_modalMode == "create" ? FormContent : null) : FormContent;

    private RenderFragment TableArea => @<text>
        @if (Source.Error is not null)
        {
            <p class="crud-page-error">Erreur : @Source.Error</p>
        }
        <DataTable T="T" Data="Source.Data" Columns="Columns" GetRowId="GetRowId" SelectedRowIds="Selection"
                   OnSelectionChange="ids => _selectedIds = ids" OnRowDoubleClick="RowDoubleClickAsync" ExportFileName="@Title"
                   ToolbarStart="Toolbar" ExpandedRowId="@(IsRowExpandMode && _modalMode == "edit" ? _editId : null)"
                   RenderExpandedRow="ExpandedRow" />
        @if (Source.Paginated)
        {
            // PageSize 0 (« Tous ») : une seule page, l'API renvoie tout sans découpage.
            var pageCount = Source.PageSize > 0 ? Math.Max(1, (int)Math.Ceiling(Source.Total / (double)Source.PageSize)) : 1;
            <div class="pagination-bar">
                <span class="pagination-info">
                    Page <span class="pagination-page">@Source.Page</span> / @pageCount — @Source.Total résultat@(Source.Total > 1 ? "s" : "")
                </span>
                <div class="pagination-controls">
                    <select class="pagination-size" value="@Source.PageSize" @onchange="e => Source.SetPageSizeAsync(int.Parse((string)e.Value!, CultureInfo.InvariantCulture))" aria-label="Résultats par page">
                        <option value="10">10 / page</option>
                        <option value="25">25 / page</option>
                        <option value="50">50 / page</option>
                        <option value="100">100 / page</option>
                        <option value="0">Tous</option>
                    </select>
                    <div class="pagination-nav">
                        <button type="button" class="pagination-button" disabled="@(Source.Page <= 1)" @onclick="() => Source.SetPageAsync(Source.Page - 1)" aria-label="Page précédente">
                            <Icon Name="crud.ChevronLeft" />
                        </button>
                        <button type="button" class="pagination-button" disabled="@(Source.Page >= pageCount)" @onclick="() => Source.SetPageAsync(Source.Page + 1)" aria-label="Page suivante">
                            <Icon Name="crud.ChevronRight" />
                        </button>
                    </div>
                </div>
            </div>
        }
    </text>;

    private RenderFragment Toolbar => @<text>
        @if (Searchable)
        {
            <TableSearch Value="@Source.Search" OnChange="Source.SetSearchAsync" />
        }
        @ToolbarExtra
    </text>;

    private RenderFragment? ExpandedRow => IsRowExpandMode && _modalMode == "edit"
        ? @<RowFicheContent Title="@FormTitle" OnClose="RequestCloseFormAsync">@FormContent</RowFicheContent>
        : null;

    public void Dispose()
    {
        Source.Changed -= OnSourceChanged;
        _formScope.Detach();
    }
}
