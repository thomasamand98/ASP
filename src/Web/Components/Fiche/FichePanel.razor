@* monté à la première visite puis juste masqué, pour ne pas perdre la saisie *@
@if (_visited)
{
    <div hidden="@(!Active)">@ChildContent</div>
}

@code {
    private bool _visited;

    [Parameter] public bool Active { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet() => _visited |= Active;
}
