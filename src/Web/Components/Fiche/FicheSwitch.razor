@* codes 0/1 WinDev *@
<label class="fiche-switch">
    <input type="checkbox" role="switch" checked="@Checked" @onchange="e => CheckedChanged.InvokeAsync(e.Value is true)" />
    <span class="fiche-switch-track" aria-hidden="true"></span>
    <span>@Label</span>
</label>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
}
