@* pousse le tableau au lieu de le recouvrir *@
<div class="vm-inline">
    <div class="vm-inline-panel@(Open ? " open" : string.Empty)">
        <div class="vm-inline-panel-inner">
            <div class="vm-inline-header">
                <h3 class="vm-inline-title">@Title</h3>
                <button type="button" class="vm-inline-close" @onclick="OnClose" aria-label="Fermer">×</button>
            </div>
            <div class="vm-inline-body">@Form</div>
        </div>
    </div>
    @Table
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? Form { get; set; }
    [Parameter] public RenderFragment? Table { get; set; }
}
