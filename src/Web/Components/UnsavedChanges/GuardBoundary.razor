@implements IDisposable
@inject UnsavedChangesService Service

@* Scope fourni si le parent doit pouvoir la vérifier, sinon zone propre *@
<CascadingValue Value="CurrentScope">@ChildContent</CascadingValue>

@code {
    private GuardScope? _own;

    [CascadingParameter] public GuardScope? Parent { get; set; }

    [Parameter] public GuardScope? Scope { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private GuardScope CurrentScope => Scope ?? (_own ??= CreateOwn());

    private GuardScope CreateOwn()
    {
        var scope = new GuardScope(Parent ?? Service.Root);
        scope.Attach();
        return scope;
    }

    public void Dispose() => _own?.Detach();
}
