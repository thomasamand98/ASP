@* Pastille de couleur : un clic ouvre la palette native du navigateur
   (<input type="color"> posé, transparent, sur la pastille) ; la valeur est
   lue et renvoyée en entier WinDev, tel que stocké en base (voir
   Shared/WindevColor.cs). « × » efface la couleur (0). *@
<span class="color-field">
    <span class="color-field-swatch@(Hex is null ? " color-field-swatch--none" : string.Empty)" style="@(Hex is null ? null : $"background: {Hex}")">
        <input type="color" aria-label="@Label" title="@(Hex is null ? $"{Label} : aucune" : $"{Label} : {Hex}")"
               value="@(Hex ?? "#000000")" @oninput="e => ValueChanged.InvokeAsync(WindevColor.FromHex(e.Value as string ?? string.Empty))" />
    </span>
    @if (Hex is not null)
    {
        <button type="button" class="color-field-clear" @onclick="() => ValueChanged.InvokeAsync(0)" title="Retirer la couleur" aria-label="Retirer @Label.ToLowerInvariant()">×</button>
    }
</span>

@code {
    // Couleur WinDev (entier) ; 0 = pas de couleur.
    [Parameter] public long Value { get; set; }
    [Parameter] public EventCallback<long> ValueChanged { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    private string? Hex => WindevColor.ToHex(Value);
}
