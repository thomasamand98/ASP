@inject ApiClient Api

@* Nouveau crée le contact déjà lié à la société *@
<CrudPage T="Contact" TDto="CreateContactDto" TDetail="ContactDetail"
          Title="Contacts" LoadingLabel="Chargement des contacts..."
          Source="_list" Columns="Columns" GetRowId="c => c.IDCONTACTS"
          Create="_api.CreateAsync" Update="_api.UpdateAsync" Remove="_api.RemoveAsync" GetDetail="_api.GetAsync" Searchable="true"
          DeleteConfirmMessage="Supprimer ce contact ?" CreateModalTitle="Nouveau contact" EditModalTitle="Modifier le contact"
          Entity="contacts" NewRecordScope="@($"societe:{SocieteId}")">
    <RenderForm Context="form">
        <ContactForm Initial="form.Initial" Societes="_societes.Data" DefaultSocieteId="@SocieteId" OnSubmit="form.OnSubmit" OnCancel="form.OnCancel" />
    </RenderForm>
</CrudPage>

@code {
    // sans Société, Fonction/Service = lien avec cette société
    private static readonly IReadOnlyList<Column<Contact>> Columns = [.. ContactsPage.Columns.Where(c => c.Id != "societe")];

    private ApiList<Contact> _list = default!;
    private CrudApi<CreateContactDto, Contact, ContactDetail> _api = default!;
    private ApiList<Societe> _societes = default!;

    [Parameter, EditorRequired] public string SocieteId { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        _list = new ApiList<Contact>(Api, "contacts") { Paginated = true };
        _list.Configure(1, 25, "", new Dictionary<string, string> { ["societeId"] = SocieteId });
        _api = new CrudApi<CreateContactDto, Contact, ContactDetail>(Api, "contacts");
        _societes = new ApiList<Societe>(Api, "societes");
        _societes.Changed += StateHasChanged;
        await Task.WhenAll(_list.RefetchAsync(), _societes.RefetchAsync());
    }
}
